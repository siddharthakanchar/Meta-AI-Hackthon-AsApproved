# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
secrets.toml
.streamlit/secrets.toml

# Signing keys — the private key lives here; the .pub does not match *.key
data/keys/

# Generated data (regenerable; keep the repo light)
data/evidence/
data/masters/
data/variants/

# data/cache/ is deliberately NOT here. Everything above rebuilds from code —
# make_masters.py and make_variants.py reproduce all 60 assets byte for byte.
# Recorded model responses do not: without a key they cannot be regenerated at
# all, so ignoring them meant scripts/sam_region_delta.py raised CacheMiss on a
# clean clone and the SAM result was unverifiable by anyone but us. They are
# evidence, not build output. Currently 6.8 KB.

# data/runs/ IS committed: it is what the hosted demo reads, and the whole
# point of cache-only hosting is that the demo cannot fail on a live call.
# Previews are downscaled JPEGs; the masters and variants stay out and are
# regenerated by the scripts.
costs.jsonl
*.sqlite
*.sqlite3
*.db

# Keep committed fixtures / labels (explicitly re-included)
!data/labels/
!data/fixtures/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/

# Scratch
scratch/
*.tmp
ASAPPROVED_BUILD_PLAYBOOK.md
