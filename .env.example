# AsApproved — environment variable NAMES only. Never put real values in this file.
# Copy to .env (which is gitignored) and fill in there.

# ---- Meta Model API (Muse Spark 1.3, SAM 3.1, Muse Voice Transcribe) ----
# dev.meta.ai -> project -> API keys -> create key on the STANDARD tier.
# Standard tier is mandatory: Contributor tier lets Meta train on our content (playbook §7).
META_MODEL_API_KEY=
# Verified 26 Oct 2026: https://api.meta.ai/v1 (OpenAI-compatible). Leave blank to use that.
META_MODEL_BASE_URL=
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# ---- Meta Marketing API (Advantage+ settings, previews, opt-out writes) ----
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_GRAPH_API_VERSION=

# ---- Neo4j (lineage + blast radius) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Signing key for approval manifests (Ed25519) ----
# Path to the private key file. Generate with: asapproved keygen
ASAPPROVED_SIGNING_KEY_PATH=data/keys/manifest_ed25519.key

# ---- Runtime behaviour ----
# demo  = replay every model call from cache, make no network calls (used by the hosted demo)
# live  = allow real model/API calls, still cache everything
ASAPPROVED_MODE=demo
ASAPPROVED_DATA_DIR=data
# Spark reasoning effort for interactive paths. Keep low/minimal: high effort is 30-70s TTFT.
ASAPPROVED_SPARK_EFFORT=low
